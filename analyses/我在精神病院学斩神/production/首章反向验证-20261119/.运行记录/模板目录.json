{
  "key": "novel.chapter.writer@v11",
  "id": "novel.chapter.writer",
  "version": "v11",
  "taskType": "writer",
  "mode": "text",
  "language": "zh",
  "family": "novel",
  "shortDescription": "章节正文生成",
  "description": "根据章节任务、角色状态、世界规则和风格约束生成章节正文。",
  "outputType": "text",
  "contextPolicy": {
