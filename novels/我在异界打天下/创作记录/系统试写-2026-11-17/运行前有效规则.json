        "detectPatterns": [
          "首先",
          "然后",
          "接着",
          "最后"
        ],
        "rewriteSuggestion": "拉开句式长度和起句方式，打散结构。",
        "promptInstruction": "警惕连续句式重复和排比化表达。",
        "autoRewrite": false,
        "enabled": true,
        "globalBaselineEnabled": true,
